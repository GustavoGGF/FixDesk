# ================================================================================
# DATABASE CONNECTION POOL CONFIGURATION
# ================================================================================
# These variables control the Django ORM database connection pool behavior
# Copy these to your .env file and adjust values as needed

# Pool Status
DB_POOL_ENABLED=true

# Minimum number of idle connections to keep open (default: 2)
# For development: 1
# For production: 2-5
DB_POOL_MIN=2

# Maximum number of connections in the pool (default: 5)
# For development: 2-3
# For production: 5-10
# For high concurrency: 15-20
DB_POOL_MAX=5

# Maximum number of extra connections allowed beyond MAX (default: 10)
# These are temporary and will be closed when no longer needed
DB_POOL_MAX_OVERFLOW=10

# Maximum idle time in seconds before a connection is recycled (default: 3600)
# 3600 = 1 hour
# For high churn environments: 1800 (30 minutes)
DB_POOL_IDLE_TIME=3600

# Connection recycle time in seconds (default: 3600)
# Useful for connections that might get stale over time
DB_POOL_RECYCLE=3600

# Check if connection is still alive before using (default: true)
# Prevents "MySQL has gone away" errors
DB_POOL_PRE_PING=true

# Echo all SQL queries to logger (default: false)
# Only enable in DEBUG mode for troubleshooting
DB_POOL_ECHO=false

# Health check interval in seconds (default: 300)
# How often to verify pool health
DB_POOL_HEALTH_CHECK_INTERVAL=300

# ================================================================================
# RECOMMENDATIONS BY ENVIRONMENT
# ================================================================================

# DEVELOPMENT (single developer machine)
# DB_POOL_MIN=1
# DB_POOL_MAX=2
# DB_POOL_MAX_OVERFLOW=3
# DB_POOL_ECHO=true

# STAGING/TESTING
# DB_POOL_MIN=2
# DB_POOL_MAX=5
# DB_POOL_MAX_OVERFLOW=10
# DB_POOL_IDLE_TIME=1800

# PRODUCTION (4 workers)
# DB_POOL_MIN=2
# DB_POOL_MAX=5
# DB_POOL_MAX_OVERFLOW=10
# DB_POOL_IDLE_TIME=3600

# HIGH CONCURRENCY (10+ pods/workers)
# DB_POOL_MIN=5
# DB_POOL_MAX=20
# DB_POOL_MAX_OVERFLOW=30
# DB_POOL_IDLE_TIME=1800
